# Kopieer naar .env en vul aan. Ontbrekende waarden leiden tot een
# WARNING/UNKNOWN in de cockpit voor de betreffende check, geen crash.

# Basic-auth token voor PoolParty API-checks (zoals gebruikt in service-dashboard).
POOLPARTY_TOKEN=

# GitHub token met minimaal 'repo' of 'actions:read' scope voor hogere
# rate limits op de Actions-API. Werkt ook zonder, maar dan beperkt tot
# 60 requests/uur per IP.
GITHUB_TOKEN=

# Alleen instellen op hosts zonder persistente schijf (bv. Render free tier):
# leest de trendhistorie read-only van deze URL i.p.v. lokaal data/history.sqlite
# te schrijven. De .github/workflows/record-history.yml Action houdt deze URL
# elke 30 minuten bij. Laat leeg voor lokale ontwikkeling.
HISTORY_REMOTE_URL=

# Alleen relevant voor scripts/record_history.py (draait via de Action, niet
# via de live app): ntfy.sh-topic voor push-alerts bij een NIEUWE FAIL.
# Kies een niet-voor-de-hand-liggende topic-naam (werkt zonder registratie,
# maar iedereen die de naam kent kan meelezen) en abonneer je erop via de
# ntfy-app of https://ntfy.sh/<topic>. Leeg = geen alerts.
NTFY_TOPIC=

# PoolParty (zie poolparty_checks in config/sources.yaml). Twee manieren:
#  a) gebruikersnaam + token apart (aanbevolen, makkelijk te testen):
#       POOLPARTY_USER / POOLPARTY_TOKEN           -> productie
#       POOLPARTY_USER_TEST / POOLPARTY_TOKEN_TEST -> testomgeving
#     Het "token" is het wachtwoord/API-wachtwoord bij die gebruiker.
#  b) alleen *_TOKEN met een kant-en-klare base64 van "gebruiker:wachtwoord"
#     en de *_USER-variabele leeg (zoals het eerder werkte).
# Gebruik bij voorkeur een read-only account en voor lokaal testen alleen de
# testomgeving. .env staat in .gitignore.
POOLPARTY_USER=
POOLPARTY_USER_TEST=
POOLPARTY_TOKEN_TEST=
