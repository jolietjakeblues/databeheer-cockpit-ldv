# Kopieer naar .env en vul aan. Ontbrekende waarden leiden tot een
# WARNING/UNKNOWN in de cockpit voor de betreffende check, geen crash.

# Basic-auth token voor PoolParty API-checks (zoals gebruikt in service-dashboard).
POOLPARTY_TOKEN=

# GitHub token met minimaal 'repo' of 'actions:read' scope voor hogere
# rate limits op de Actions-API. Werkt ook zonder, maar dan beperkt tot
# 60 requests/uur per IP.
GITHUB_TOKEN=
